{
    "name": "rijal/inertia-clone",
    "type": "project",
    "description": "Personal website clone built with Laravel and Inertia",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "inertiajs/inertia-laravel": "^1.0",
        "laravel/sanctum": "^3.0",
        "laravel/tinker": "^2.8",
        "tightenco/ziggy": "^2.5",
        "laravel/jetstream": "^4.3"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\\\Foundation\\\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
